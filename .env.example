# Copy to .env and fill in locally. Never commit .env.
# All values are optional; the offline profile needs none of them.

# Hugging Face (gated model downloads). On Colab, use Colab Secrets instead.
HF_TOKEN=

# Cache locations (defaults resolve under ./cache when unset)
SWI_CACHE_DIR=
HF_HOME=

# Runtime overrides (see docs/configuration.md)
SWI_PROFILE=
SWI_DEVICE=
SWI_PLATFORM=

# Optional cloud baselines (disabled unless the cloud_fallback profile is used)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
